# ============================================================
# Modèle de configuration locale.
#
#   cp .env.example .env.local   puis remplir
#
# ⚠️ `.env.local` N'EST PAS VERSIONNÉ, et ne doit jamais l'être. Seul ce
#    modèle-ci l'est. En production, ces valeurs se posent dans les
#    variables d'environnement du projet Cloudflare Pages.
#
# ⚠️ AUCUNE VARIABLE SECRÈTE NE PORTE LE PRÉFIXE `PUBLIC_`. Astro expose
#    au navigateur tout ce qui le porte — c'est exactement ainsi qu'une
#    clé de service part en production. Une seule ligne ci-dessous le
#    porte, et c'est délibéré.
# ============================================================

# ---- Supabase -----------------------------------------------------
# L'adresse du projet, sans barre finale.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Clé « publishable » : publique par conception. Elle sert ici à l'authentification
# du back-office (GoTrue la réclame pour identifier le projet) et
# n'autorise aucune lecture — toutes les tables sont sous RLS sans
# politique.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_

# ⚠️ Clé « secret » : elle CONTOURNE toute la sécurité de la base.
#    Elle ne doit jamais atteindre un navigateur, ni un dépôt.
SUPABASE_SECRET_KEY=sb_secret_

# Les anciennes clés restent acceptées pour les projets Supabase existants :
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=

# ---- Stripe -------------------------------------------------------
# La clé publiable est la seule variable exposée au navigateur : c'est son
# rôle, Stripe Elements la lit dans la page.
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Clé secrète et secret de signature du webhook.
# `sk_live_` est refusé tant que `parametres.tarifs_provisoires` est levé.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ---- Synchronisation Airbnb ---------------------------------------
# Protège POST /api/ical-import. Une chaîne longue et aléatoire.
ICAL_IMPORT_SECRET=

# ---- Courrier (facultatif) ----------------------------------------
# Sans ces trois lignes, le formulaire de contact répond « envoi
# indisponible » ; le reste du site fonctionne.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
