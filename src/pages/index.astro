---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Tile from '../components/Tile.astro';
import Reserver from '../components/Reserver.astro';
import FormeReservation from '../components/FormeReservation.astro';
import { VILLA, GALLERY } from '../lib/villa';
import { cleImage } from '../lib/contenu-site';

/* ============================================================
   L'accueil suit la structure de villadellatorre.it/en, relevée
   section par section sur la capture du site :

     bannière vidéo → titre centré → citation en italique →
     composition à trois colonnes → image pleine largeur →
     deux tuiles → image en galet avec texte dedans →
     texte centré étroit → deux tuiles →
     bloc teinté (titre, texte, deux tuiles) → clôture

   Deux mesures seulement, comme chez eux : 87,5 rem pour la page,
   56,25 rem pour ce qui se lit au centre (leurs `strip--normal` et
   `strip--narrow`). Aucun repère numéroté, aucune grille de chiffres
   dans le corps de page : leur rythme alterne texte centré, image,
   et paires de tuiles — rien d'autre.
   ============================================================ */

/* ------------------------------------------------------------
   Pour qui ?

   Le chalet n'a qu'une chambre : la liste des pièces ne dirait rien.
   Ce qui le distingue, c'est À QUI il s'adresse — et l'annonce le dit
   en toutes lettres : curistes, saisonniers, randonneurs, professionnels
   en déplacement. La table des matières de l'accueil nomme donc ces
   voyageurs, chacun avec la photographie qui lui répond.

   ⚠️ Cette section s'écarte de la structure de villadellatorre relevée
   plus haut, qui n'alterne que texte centré, image et paires de tuiles.
   L'écart est hérité du gabarit et assumé.
   ------------------------------------------------------------ */
const VOYAGEURS = [
  { nom: 'Les curistes', meta: 'Thermes à quelques minutes', href: '/digne-les-bains',
    img: '/images/digne/thermes.webp' },
  { nom: 'Les randonneurs', meta: 'Au pied de la montagne', href: '/digne-les-bains',
    img: '/images/chalet/vue-montagne.webp' },
  { nom: 'Les cyclistes', meta: 'Vélos à disposition', href: '/le-chalet',
    img: '/images/chalet/allee-chalet.webp' },
  { nom: 'Les télétravailleurs', meta: 'Bureau et wifi haut débit', href: '/le-chalet',
    img: '/images/chalet/bureau.webp' },
  { nom: 'Les amoureux de la nature', meta: 'Jardin et montagne', href: '/galerie#le-jardin',
    img: '/images/chalet/fleurs-coreopsis.webp' },
];
---
<Layout image="/images/og.jpg">
  <!-- ═══════════ I. LE FRONTISPICE ═══════════
       Le nom porte le premier écran. Il n'est pas posé SUR l'image : il est
       composé AVEC elle, sur une grille de fiche de projet — le nom au
       centre optique, les données en pied, un filet qui les sépare. C'est
       la mise en page d'une planche d'architecte, pas d'une bannière.

       Le nom est découpé mot par mot puis caractère par caractère : chaque
       lettre monte de son masque pendant que l'interlettrage se desserre
       d'un cran. C'est ce desserrement — et non la montée — qui donne
       l'impression que le nom se POSE. Détail dans `nomCinema()`. -->
  <section data-hero="dark" data-frontispice class="fronti">
    <div class="fronti__fond">
      <div data-speed="0.88" class="fronti__media">
        {/* Ni vidéo ni atmosphère WebGL ici, contrairement au gabarit : la
            photographie à contre-jour porte déjà la lumière qui bouge. */}
        <Photo src="/images/chalet/chalet-contre-jour.webp" sizes="pleine"
               data-contenu-image={cleImage('/images/chalet/chalet-contre-jour.webp')}
               alt="Le chalet en bois à contre-jour, le soleil filtrant entre les pins"
               fetchpriority="high" decoding="async" class="h-full w-full object-cover" />
      </div>
      <div class="fronti__voile"></div>
      <div class="hero-grain pointer-events-none absolute inset-0"></div>
    </div>

    <div class="fronti__grille mesure">
      <p class="fronti__lieu" data-fronti-lieu>
        <span>Digne-les-Bains</span><i aria-hidden="true"></i><span>Provence</span>
      </p>

      {/* Un seul `h1` pour le référencement ; le découpage est fait par le
          script, qui repose le texte à l'identique. Sans JS, le nom reste un
          titre lisible — c'est la seule chose qui compte ici. */}
      <h1 class="fronti__nom" data-nom>Chalet Cosy</h1>

      <p class="fronti__dit" data-fronti-dit data-contenu="accueil.hero.texte">
        Un chalet de bois tout confort au pied de la montagne&nbsp;— à deux pas des thermes.
      </p>

      {{/* L'appel à l'action mène directement au formulaire de contact. */}
      <a href="/contact" class="btn btn-light fronti__cta" data-fronti-cta>
        Réserver
      </a>

      <dl class="fronti__fiche data-fronti-fiche>
        <div><dt>Surface</dt><dd>{VILLA.surface} m²</dd></div>
        <div><dt>Voyageurs</dt><dd>Quatre</dd></div>
        <div><dt>Chambre</dt><dd>Une</dd></div>
        <div><dt>Vélos</dt><dd>Fournis</dd></div>
      </dl>
    </div>

    <div class="hero-scroll" aria-hidden="true">
      <span class="hero-scroll__word">Défiler</span>
      <span class="hero-scroll__rail"><i></i></span>
    </div>
  </section>

  <!-- ═══════════ II. L'ÉNONCÉ ═══════════
       Une phrase, et rien autour. Elle n'annonce pas le chalet — elle le
       situe. Le verbe est au présent, la phrase tient en deux souffles :
       c'est ce qui la distingue d'un slogan. -->
  <section class="bande-cite">
    <div class="mesure mesure--etroite">
      <p class="enonce" data-anim="lignes" data-contenu="accueil.introduction">
        Un chalet de mélèze posé dans un jardin, au pied des montagnes de Digne.
        On y entend le vent dans les arbres, les oiseaux, et rien d’autre.
      </p>
    </div>
  </section>

  <!-- ═══════════ IV. LA COMPOSITION À TROIS COLONNES ═══════════
       Le dispositif exact de Torre : une image haute à gauche, le texte
       au centre décalé vers le bas, deux images empilées à droite et
       alignées à droite. Aucune colonne ne commence à la même hauteur. -->
  <section class="bande">
    <div class="mesure">
      <div class="editorial" data-colonnes>
        <figure class="editorial__tall hover-zoom">
          <Photo src="/images/chalet/jardin-pelouse.webp" sizes="tiers" loading="lazy" decoding="async"
                 alt="Le jardin du chalet ouvert sur la montagne boisée"
                 data-contenu-image="accueil.presentation.image"
                 class="h-full w-full object-cover" />
        </figure>

        <div class="editorial__text">
          <p class="prose-body" data-contenu="accueil.presentation.texte1">
            Du bois partout, dedans comme dehors : un cadre apaisant, entre nature et
            thermes, pensé pour les curistes, les randonneurs, les saisonniers et les
            professionnels en déplacement.
          </p>
          <p class="prose-body mt-5" data-contenu="accueil.presentation.texte2">
            {VILLA.surface} m² de plain-pied. Une chambre, un canapé convertible, une salle
            d’eau. Jusqu’à {VILLA.guests} voyageurs. On loue le chalet entier.
          </p>
          <a href="/le-chalet" class="lire mt-8">Visiter le chalet</a>
        </div>

        <div class="editorial__stack">
          <figure class="hover-zoom">
            <Photo src="/images/chalet/terrasse-table.webp" sizes="tiers" loading="lazy" decoding="async"
                   data-contenu-image={cleImage('/images/chalet/terrasse-table.webp')}
                   alt="La terrasse en bois, sa table en verre et ses chaises vertes face à la montagne"
                   class="h-full w-full object-cover" />
          </figure>
          <figure class="hover-zoom">
            <Photo src="/images/chalet/fleurs-coreopsis.webp" sizes="tiers" loading="lazy" decoding="async"
                   data-contenu-image={cleImage('/images/chalet/fleurs-coreopsis.webp')}
                   alt="Un massif de coréopsis jaunes et rouges dans le jardin"
                   class="h-full w-full object-cover" />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ V. L'IMAGE PLEINE LARGEUR ═══════════ -->
  <section class="bande">
    <div class="mesure">
      <figure data-anim="capsule" data-derive class="hover-zoom aspect-[16/9] overflow-hidden bg-sand">
        <Photo src="/images/chalet/chalet-terrasse.webp" sizes="pleine" loading="lazy" decoding="async"
               data-contenu-image={cleImage('/images/chalet/chalet-terrasse.webp')}
               alt="Le chalet en mélèze et sa grande terrasse, au soleil du matin"
               class="h-full w-full object-cover" />
      </figure>
    </div>
  </section>

  <!-- ═══════════ V bis. POUR QUI ? ═══════════
       Une table des matières, pas une rangée de vignettes : des noms en
       très grand corps, et UNE seule image, qui suit le curseur et change
       de ligne en ligne.

       La liste se lit entièrement sans souris : chaque ligne est un lien,
       et la vignette n'est qu'un supplément. Les photographies restent
       dans le HTML ; seul leur conteneur est déplacé sur `body` au
       montage — un élément `position: fixed` laissé dans `#smooth-content`
       défilerait avec la page, ScrollSmoother le déplaçant par
       transformation. -->
  <section class="bande bg-ink text-bone">
    <div class="mesure">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-5">
        <h2 data-anim="lignes" data-contenu="accueil.voyageurs.titre" class="h-lg">Un chalet,<br />cinq façons d’y venir.</h2>
        <a href="/digne-les-bains" class="link-arrow !text-bone">
          Voir les environs
          <svg width="26" height="8" viewBox="0 0 26 8" fill="none" aria-hidden="true">
            <path d="M0 4h24M21 1l3 3-3 3" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </a>
      </div>

      <div data-index class="mt-12">
        {VOYAGEURS.map((v, i) => (
          <a href={v.href} class="index-row">
            <span class="idx num">{String(i + 1).padStart(2, '0')}</span>
            <span>{v.nom}</span>
            <span class="meta">{v.meta}</span>
          </a>
        ))}

        {/* `aria-hidden` : la vignette illustre ce que la ligne dit déjà. Les
            `alt` restent vides pour la même raison. */}
        <div class="index-peek" aria-hidden="true">
          {VOYAGEURS.map((v) => (
            <Photo src={v.img} sizes="vignette" alt="" loading="lazy" decoding="async" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ VI. DEUX TUILES ═══════════
       Chez Torre les tuiles vont toujours par deux, jamais par trois. -->
  <section class="bande">
    <div class="mesure">
      <div class="duo">
        <Tile href="/le-chalet" img="/images/chalet/salon-lumiere.webp"
              alt="Le salon baigné de soleil, canapé blanc et table ronde en bois"
              title="Le chalet" cta="Parcourir le chalet" sizes="moitie"
              abstract="Une pièce à vivre lumineuse, une chambre, un coin bureau, et une terrasse face à la montagne." />
        <Tile href="/galerie" img="/images/chalet/chalet-face.webp"
              alt="Le chalet de face, l’escalier de la terrasse et l’allée de gravier"
              title="La galerie" cta={`Voir les ${GALLERY.length} photographies`} sizes="moitie"
              abstract="Le chalet entier, de l’allée au jardin." />
      </div>
    </div>
  </section>

  <!-- ═══════════ VII. LE GALET ═══════════
       Torre pose ici une image très arrondie — `border-radius: 40vw` —
       avec le texte à l'intérieur, centré. C'est leur seule forme molle
       de toute la page, et elle ne sert qu'une fois. -->
  <section class="bande">
    <div class="mesure">
      <div class="galet">
        <Photo src="/images/digne/vue-digne.webp" sizes="pleine" loading="lazy" decoding="async"
               data-contenu-image={cleImage('/images/digne/vue-digne.webp')}
               alt="Digne-les-Bains au pied du Rocher de Neuf-Heures, les montagnes boisées tout autour"
               class="h-full w-full object-cover" />
        <div class="galet__texte">
          <h2 class="galet__titre">Digne-les-Bains</h2>
          <p class="galet__dit" data-anim="montee" data-contenu="accueil.digne.texte">
            Capitale de la lavande, ville thermale et ensoleillée, entre Alpes et Provence.
            Et à deux heures de la Côte d’Azur.
          </p>
          <a href="/digne-les-bains" class="btn btn-light mt-7">Voir les environs</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════ VII bis. LA BANDE ═══════════
       Une file de photographies qui défile de côté pendant qu'on descend.
       C'est le seul endroit du site où le défilement est détourné, et il
       l'est pour MONTRER, pas pour retenir : un pixel de molette avance la
       bande d'un pixel, et la section se libère dès la dernière image.
       Elle tient la place d'une galerie sans en ouvrir une : on traverse le
       chalet d'un geste. -->
  <section data-bande class="bande-fil">
    <div class="bande-fil__piste" data-bande-piste>
      <p class="bande-fil__dit">
        <span class="bande-fil__sur">Le chalet</span>
        Trente mètres carrés,<br />tout le nécessaire.
      </p>
      {[
        ['/images/chalet/salon-canape.webp', 'Le coin salon : canapé, table basse ronde et tableaux de paysages', 'La pièce à vivre'],
        ['/images/chalet/cuisine-entree.webp', 'La cuisine équipée et la porte d’entrée vitrée', 'La cuisine'],
        ['/images/chalet/chambre-linge-blanc.webp', 'Le lit double dressé de blanc, tête de lit en bois', 'La chambre'],
        ['/images/chalet/bureau.webp', 'Le coin bureau tout en pin et sa carte du monde', 'Le bureau'],
        ['/images/chalet/terrasse-table.webp', 'La terrasse en bois et ses chaises vertes face à la montagne', 'La terrasse'],
        ['/images/chalet/jardin-pelouse.webp', 'La pelouse et la montagne sous le ciel bleu', 'Le jardin'],
      ].map(([src, alt, nom]) => (
        <figure class="bande-fil__vue">
          <div class="bande-fil__cadre hover-zoom">
            <Photo src={src} sizes="moitie" alt={alt} loading="lazy" decoding="async"
                   class="h-full w-full object-cover" />
          </div>
          <figcaption class="bande-fil__nom">{nom}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- ═══════════ VIII. LE MANIFESTE ═══════════
       L'accueil a trois moments d'énoncé, et celui-ci était le seul à ne
       pas en être un. La section II compose en serif maigre à 2,35 rem, la
       clôture en italique à 2,5 rem — et cette phrase-ci, placée entre les
       deux et chargée de dire où l'on se trouve, tenait en corps de texte
       à 1,02 rem. Elle passait donc pour une légende, quand elle est le
       pivot de la page : c'est là que le chalet cesse d'être un intérieur
       et devient un lieu.

       Elle prend `.manifest`, qui l'emporte sur les deux autres — serif à
       450, jusqu'à 2,6 rem — et dont l'italique bronze porte la chute.
       C'est ce qui donne enfin une HIÉRARCHIE aux trois énoncés au lieu
       d'une alternance : le premier situe le chalet, celui-ci situe le
       territoire, le dernier referme.

       ⚠️ Le geste `lignes` n'est pas un ornement ajouté au passage : les
       sections II et XI l'ont toutes deux, celle-ci était la seule à
       retomber sur la montée par défaut de la passe automatique. -->
  <section class="bande-cite">
    <div class="mesure mesure--etroite">
      <p class="manifest text-center" data-anim="lignes">
        Deux pas pour gagner le centre-ville. Quelques minutes pour les thermes et le Musée
        Promenade. Le reste du temps, le jardin se referme et l’on <em>n’entend plus que les oiseaux</em>.
      </p>
    </div>
  </section>

  <!-- ═══════════ IX. DEUX TUILES ═══════════ -->
  <section class="bande">
    <div class="mesure">
      <div class="duo">
        <Tile href="/digne-les-bains" img="/images/digne/dalle-ammonites.webp"
              alt="La dalle aux ammonites, une roche grise couverte de fossiles spiralés"
              title="Le Géoparc" cta="Suivre les fossiles" sizes="moitie"
              abstract="La dalle aux ammonites, le Musée Promenade, la via ferrata du Rocher de Neuf-Heures : deux cents millions d’années à ciel ouvert." />
        <Tile href="/digne-les-bains" img="/images/digne/lavande-valensole.webp"
              alt="Rangs de lavande en fleurs sur le plateau de Valensole, un arbre isolé à l’horizon"
              title="La lavande" cta="Partir sur le plateau" sizes="moitie"
              abstract="Digne est la capitale de la lavande. En juillet, les champs du plateau de Valensole fleurissent à moins d’une heure de route." />
      </div>
    </div>
  </section>

  <!-- ═══════════ X. LE BLOC TEINTÉ ═══════════
       Torre change de fond pour son dernier chapitre et y remet la même
       suite : titre centré, texte, puis deux tuiles. -->
  <section class="bande bg-sand">
    <div class="mesure">
      <h2 data-anim="lignes" data-contenu="accueil.conclusion" class="titre-bloc">Le chalet entier, pour vous seuls.</h2>
      <p class="prose-body mesure--etroite mt-7 text-center">
        Une chambre, un canapé convertible, {VILLA.guests} voyageurs au plus. À la semaine
        ou pour quelques nuits — et les longs séjours sont les bienvenus.
      </p>

      <div class="duo mt-14">
        <Tile href="/contact" img="/images/chalet/chalet-fleurs.webp"
              alt="Le chalet entre les arbres, fleurs mauves au premier plan"
              title="Séjourner" cta="Demander les disponibilités" sizes="moitie"
              abstract={`Arrivée ${VILLA.checkIn}. Départ ${VILLA.checkOut}.`} />
        <Tile href="/contact" img="/images/chalet/bureau.webp"
              alt="Le coin bureau tout en pin, plan de travail jaune et carte du monde"
              title="Rester longtemps" cta="Demander un tarif" sizes="moitie"
              abstract="Cure thermale, mission, saison : séjours de 28 nuits et plus acceptés. Tarifs sur demande." />
      </div>
    </div>
  </section>

  <!-- ═══════════ X bis. LA RÉSERVATION ═══════════ -->
  <Reserver />
  <FormeReservation />

  <!-- ═══════════ XI. LA CLÔTURE ═══════════ -->
  <section class="bande-cite">
    <div class="mesure mesure--etroite text-center">
      <p class="cite cite--fin" data-anim="lignes">
        Dites-nous vos dates.<br />Nous répondons sous vingt-quatre heures.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn btn-primary">Réserver le séjour</a>
        <a href="/contact" class="btn btn-ghost">Nous écrire</a>
      </div>
      <p class="num mt-9 text-[0.74rem] uppercase tracking-[0.16em] text-muted">
        ★ {VILLA.rating} · avis de voyageurs
      </p>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Les deux mesures de Torre ----------
     87,5 rem pour la page, 56,25 rem pour ce qui se lit au centre.
     Ce sont leurs valeurs exactes (`strip--normal`, `strip--narrow`) :
     l'écart entre les deux est ce qui fait respirer leur accueil. */
  .mesure { width: 100%; max-width: 87.5rem; margin-inline: auto; padding-inline: var(--gutter); }
  .mesure--etroite { max-width: 56.25rem; margin-inline: auto; }

  /* Trois hauteurs de bande, et pas une de plus : la pleine, celle du
     texte centré (plus aérée, c'est là qu'on s'arrête), et celle du
     titre. Le même `padding` partout était l'un des défauts relevés. */
  .bande { padding-block: clamp(3.5rem, 7vw, 7rem); }
  .bande-cite { padding-block: clamp(5rem, 11vw, 10rem); }
  .bande-tit { padding-block: clamp(4.5rem, 9vw, 8rem) clamp(1rem, 2vw, 2rem); }

  /* ---------- Le titre d'accueil ----------
     Centré et seul. Chez Torre il tient sur deux lignes, la seconde
     portant le nom du lieu. */
  .titre-accueil {
    font-family: theme('fontFamily.serif'); font-weight: 400;
    font-size: clamp(2.4rem, 7vw, 5.6rem); line-height: 1.06;
    letter-spacing: -0.022em; text-align: center;
  }

  .titre-bloc {
    font-family: theme('fontFamily.serif'); font-weight: 400;
    font-size: clamp(1.9rem, 4.4vw, 3.4rem); line-height: 1.08;
    letter-spacing: -0.018em; text-align: center;
    max-width: 22ch; margin-inline: auto;
  }

  /* ---------- La citation ----------
     Italique, centrée, à la moitié du corps du titre — c'est le rapport
     de Torre entre `strip__title1` et `strip__title3`. Les guillemets
     sont français et font partie du texte : ils se sélectionnent et se
     lisent à voix haute, ce qu'un `::before` décoratif ne ferait pas. */
  .cite {
    font-family: theme('fontFamily.serif'); font-style: italic; font-weight: 400;
    font-size: clamp(1.35rem, 3.4vw, 2.5rem); line-height: 1.28;
    letter-spacing: -0.012em; text-align: center; text-wrap: balance;
  }
  .cite--fin { font-size: clamp(1.2rem, 2.6vw, 1.9rem); color: theme('colors.graphite'); }

  /* ---------- La composition à trois colonnes ---------- */
  .editorial { display: grid; gap: clamp(2rem, 5vw, 3.5rem); }
  .editorial__tall { overflow: hidden; aspect-ratio: 2 / 3; background: theme('colors.sand'); }
  .editorial__stack { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); }
  .editorial__stack figure { overflow: hidden; background: theme('colors.sand'); }
  .editorial__stack figure:first-child { aspect-ratio: 4 / 3; }
  .editorial__stack figure:last-child { aspect-ratio: 1 / 1; }

  @media (min-width: 860px) {
    .editorial { grid-template-columns: 0.8fr 1.2fr 0.8fr; align-items: start;
                 gap: clamp(1.75rem, 3.5vw, 3rem); }
    /* Le décalage : chaque colonne descend un peu plus que la précédente. */
    .editorial__text { padding-top: clamp(3rem, 9vw, 7rem); }
    .editorial__stack { padding-top: clamp(6rem, 16vw, 12rem); }
  }

  /* ---------- Le lien « lire la suite » ----------
     Chez Torre, `read-more` est un libellé souligné qui pousse une flèche
     à sa droite au survol. */
  .lire {
    display: inline-flex; align-items: center; gap: 0.6em;
    font-family: theme('fontFamily.sans'); font-size: 0.74rem; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.16em; color: theme('colors.ink');
    border-bottom: 1px solid theme('colors.hair'); padding-bottom: 0.5em;
    transition: border-color .5s var(--ease-expo);
  }
  .lire::after { content: '→'; transition: transform .5s var(--ease-expo); }
  .lire:hover { border-color: theme('colors.ink'); }
  .lire:hover::after { transform: translateX(5px); }

  /* ---------- Le galet ----------
