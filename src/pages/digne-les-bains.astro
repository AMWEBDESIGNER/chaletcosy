---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Photo from '../components/Photo.astro';
import { VILLA, mapUrl } from '../lib/villa';
import { breadcrumb } from '../lib/seo';

/* Un seul littéral : le fil visible et son balisage disent le même chemin. */
const trail: [string, string][] = [['Digne-les-Bains', '/digne-les-bains']];

/* Les alentours, du plus proche au plus lointain : le Musée Promenade
   tout près du chalet, la ville et ses thermes, puis la montagne et,
   plus loin, le plateau de lavande.

   `poids` dit la STATURE du lieu, et c'est lui qui commande la place qu'il
   prend sur la page. Un Géoparc mondial et un champ de lavande qui
   s'étend à perte de vue sont `grand`, un musée ou les thermes sont
   `moyen`, une maison d'écrivain ou un plan d'eau sont `intime`.

   Les lieux sont ceux que cite l'annonce du chalet : le Musée Promenade,
   le Musée Gassendi, la maison d'Alexandra David-Néel, la dalle aux
   ammonites et sa via ferrata, le Rocher de Neuf-Heures, le plan d'eau.
   Faute de photographie libre, le Musée Gassendi et le plan d'eau sont
   cités dans le texte de lieux voisins plutôt que d'avoir leur carte.

   ⚠️ Ce sont des contenus TERMINAUX — ils ne mènent nulle part. Tout y
   reste donc visible en permanence : ni tuile qui masque son résumé au
   survol, ni nom seul renvoyant à une vignette. Seule l'échelle varie. */
const places = [
  {
    name: 'Le Musée Promenade',
    poids: 'moyen',
    meta: 'Tout près du chalet',
    img: '/images/digne/musee-promenade.webp',
    alt: 'La grande cascade du Musée Promenade, un rideau d’eau sur un rocher couvert de mousse',
    desc: "Des sentiers sous les arbres, des cascades, des salles de fossiles et des œuvres d’art posées dans la nature. C’est le repère du chalet : l’annonce le donne pour voisin.",
  },
  {
    name: 'La dalle aux ammonites',
    poids: 'grand',
    meta: 'Géoparc mondial UNESCO',
    img: '/images/digne/dalle-ammonites.webp',
    alt: 'La dalle aux ammonites, une roche grise couverte de fossiles spiralés',
    desc: "Au nord de la ville, une dalle de calcaire dressée porte plus de mille cinq cents ammonites, figées là depuis près de deux cents millions d’années. C’est le site emblématique du Géoparc de Haute-Provence.",
  },
  {
    name: 'Les thermes',
    poids: 'moyen',
    meta: 'À quelques minutes',
    img: '/images/digne/thermes.webp',
    alt: 'Les thermes de Digne, au pied d’une haute falaise dans un vallon boisé',
    desc: "Digne doit son nom à ses eaux chaudes, fréquentées depuis l’Antiquité. Les thermes accueillent les cures en rhumatologie et pour les voies respiratoires — et le chalet, les curistes, pour la durée de leur cure.",
  },
  {
    name: 'Le Rocher de Neuf-Heures',
    poids: 'grand',
    meta: 'Via ferrata et randonnées',
    img: '/images/digne/rocher-neuf-heures.webp',
    alt: 'Les crêtes rocheuses au-dessus de Digne, les sommets enneigés des Alpes à l’horizon',
    desc: "La falaise qui domine la ville porte une via ferrata, celle de la Grande Fistoire. Pour qui préfère marcher, les sentiers des Préalpes de Digne partent de partout, et les vélos du chalet attendent sous la terrasse.",
  },
  {
    name: 'Notre-Dame-du-Bourg',
    poids: 'intime',
    meta: 'Cathédrale romane',
    img: '/images/digne/notre-dame-du-bourg.webp',
    alt: 'La cathédrale Notre-Dame-du-Bourg, sa rosace et ses murs de pierre',
    desc: "L’ancienne cathédrale de Digne, grand vaisseau roman de pierre claire au bas de la ville. À quelques rues de là, le Musée Gassendi mêle beaux-arts, sciences et art contemporain — et porte les Refuges d’Art d’Andy Goldsworthy, semés le long des sentiers de montagne.",
  },
  {
    name: 'La maison d’Alexandra David-Néel',
    poids: 'intime',
    meta: 'Samten Dzong',
    img: '/images/digne/maison-david-neel.webp',
    alt: 'La maison d’Alexandra David-Néel, façade blanche aux volets verts entre les arbres',
    desc: "L’exploratrice, première Européenne entrée à Lhassa, a vécu ses dernières décennies à Digne. Sa maison se visite : souvenirs du Tibet, bibliothèque et jardin.",
  },
  {
    name: 'Le Cousson',
    poids: 'moyen',
    meta: 'Randonnée au-dessus de la ville',
    img: '/images/digne/montagne.webp',
    alt: 'Le Cousson, sommet boisé des Préalpes de Digne sous un ciel d’orage',
    desc: "La montagne qui ferme l’horizon du chalet. Son sommet se gagne à pied depuis la ville, et ses pentes font partie de ce que l’annonce appelle les richesses naturelles environnantes. Au retour, le plan d’eau des Ferréols attend au bord de la Bléone.",
  },
  {
    name: 'La lavande',
    poids: 'grand',
    meta: 'Capitale de la lavande',
    img: '/images/digne/lavande-valensole.webp',
    alt: 'Rangs de lavande en fleurs sur le plateau de Valensole',
    desc: "En juillet, le plateau de Valensole se couvre de violet à moins d’une heure de route. Début août, Digne fête sa fleur avec le Corso de la lavande, chars fleuris et fanfares dans les rues.",
  },
];

/* La stature, traduite en colonnes. Les classes sont écrites en toutes
   lettres : Tailwind lit le source pour décider de ce qu'il produit, une
   classe assemblée à l'exécution n'existerait pas dans la feuille livrée.

   Le rapport du cadre travaille avec la largeur, jamais contre elle : le
   `grand` est un portrait, donc haut ET large ; l'`intime` est un carré,
   qui occupe peu et ne cherche pas à s'étirer. Ce sont les deux ensemble
   qui font la hiérarchie — une largeur seule ne suffirait pas à distinguer
   un parc national d'une plage. */
/* `debut` est la colonne où commence l'image quand elle passe à droite, et
   il se déduit de sa largeur : elle doit toujours finir contre la douzième.
   Une valeur unique pour les trois statures laisserait une colonne vide au
   bord de page pour les deux plus étroites — un défaut d'autant plus
   visible qu'il n'affecterait qu'une image sur deux. */
const POIDS: Record<string, {
  img: string; txt: string; debut: string; ratio: string; sizes: 'deux-tiers' | 'moitie';
}> = {
  grand: { img: 'md:col-span-7', txt: 'md:col-span-4', debut: 'md:col-start-6', ratio: '4 / 5', sizes: 'deux-tiers' },
  moyen: { img: 'md:col-span-6', txt: 'md:col-span-5', debut: 'md:col-start-7', ratio: '3 / 2', sizes: 'moitie' },
  intime: { img: 'md:col-span-5', txt: 'md:col-span-4', debut: 'md:col-start-8', ratio: '1 / 1', sizes: 'moitie' },
};
---
<Layout title="Digne-les-Bains — thermes, Géoparc, lavande et montagne"
        description="Les thermes, la dalle aux ammonites, le Musée Promenade, la via ferrata et les champs de lavande : tout ce qui entoure le Chalet Cosy à Digne-les-Bains."
        image="/images/digne/vue-digne.webp"
        imageAlt="Digne-les-Bains au pied du Rocher de Neuf-Heures"
        jsonLd={breadcrumb(Astro.site, trail)}>
  <!-- En-tête -->
  <section data-hero class="container-x pt-32">
    <div class="max-w-3xl">
      <Breadcrumb trail={trail} />
      <span class="eyebrow">Aux alentours</span>
      <h1 data-contenu="digne.titre" class="display mt-6 !text-[clamp(2.3rem,5.6vw,4.6rem)]">
        <span data-anim="lignes" class="block">Digne, entre Alpes</span>
        <span class="block">et <span class="script script--accent">Provence</span></span>
      </h1>
      <p data-contenu="digne.introduction" class="lead mt-7 max-w-xl">
        Une ville thermale et ensoleillée, capitale de la lavande, au cœur d’un Géoparc
        mondial. Patrimoine, culture et nature, des événements toute l’année — et la Côte
        d’Azur à deux heures.
      </p>
    </div>
  </section>

  <!-- Panorama -->
  <section class="container-x mt-14">
    <figure data-anim="capsule" class="hover-zoom relative aspect-[16/9] overflow-hidden bg-sand">
      <Photo src="/images/digne/vue-digne.webp" sizes="article"
             alt="Digne-les-Bains au pied du Rocher de Neuf-Heures, les montagnes boisées tout autour"
             fetchpriority="high" decoding="async" class="h-full w-full object-cover" />
    </figure>
  </section>

  <!-- Les lieux -->
  {/* Des cartes de taille égale dans une grille à deux colonnes se liraient
      comme un catalogue : le Géoparc y aurait exactement le format d'un
      plan d'eau. On alterne désormais les côtés et
      l'on fait varier l'échelle selon la stature (voir `POIDS`).

      Le texte s'aligne sur le PIED de l'image (`items-end`) et non sur son
      haut : c'est ce qui fait tenir ensemble deux blocs de hauteurs
      différentes. Alignés par le haut, le titre du lieu le plus court
      flotterait au milieu du vide laissé par son voisin. */}
  <section class="section">
    <div class="container-x flex flex-col gap-y-20 md:gap-y-32">
      {places.map((p, i) => {
        const f = POIDS[p.poids];
        // Les côtés alternent. L'image des rangs impairs passe à droite —
        // en `order`, pour que le DOM garde l'image avant son texte : c'est
        // l'ordre dans lequel on lit un lieu, et celui que suit le clavier.
        const aDroite = i % 2 === 1;
        return (
          <article class="grid grid-cols-1 items-end gap-x-8 gap-y-6 md:grid-cols-12">
            <div class={`hover-zoom relative overflow-hidden bg-sand ${f.img} ${aDroite ? `md:order-2 ${f.debut}` : ''}`}
                 style={`aspect-ratio:${f.ratio}`}
                 data-anim="balayage" data-anim-sens={aDroite ? 'gauche' : undefined}>
              <Photo src={p.img} sizes={f.sizes} alt={p.alt} loading="lazy" decoding="async"
                     class="h-full w-full object-cover" />
            </div>

            {/* L'étiquette a quitté la photographie. Posée dessus, elle vivait
                sur un dégradé volontairement léger — l'assombrir aurait éteint
                les clichés — et son contraste dépendait donc de la clarté de
                chaque image : au-dessus d'un calcaire en plein soleil, elle
                passait sous le seuil AA. Sortie sur le calcaire de la page,
                elle le tient partout, et le cadre rend l'image entière. */}
            <div class={`${f.txt} ${aDroite ? 'md:order-1 md:col-start-1' : ''}`}>
              <span class="num block font-sans text-[0.68rem] uppercase tracking-[0.18em] text-bronze">
                {p.meta}
              </span>
              <h2 class="mt-3 font-serif text-[clamp(1.6rem,3vw,1.95rem)] tracking-tight">{p.name}</h2>
              <p class="mt-3 text-sm leading-relaxed text-muted">{p.desc}</p>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Se repérer -->
  <section class="section bg-sand !pt-0">
    <div class="container-x pt-[var(--section)]">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <span class="eyebrow">Se repérer</span>
          <h2 data-anim="lignes" data-contenu="digne.distances.titre" class="h-lg mt-6">À quelle distance ?</h2>
          <dl class="mt-9">
            {[
              ['Centre-ville de Digne', 'à deux pas'],
              ['Thermes de Digne-les-Bains', 'quelques minutes'],
              ['Plateau de Valensole', '45 min'],
              ['Sisteron', '40 min'],
              ['Gorges du Verdon (Moustiers)', '1 h'],
              ['Aix-en-Provence', '1 h 30'],
              ['Nice et la Côte d’Azur', '2 h'],
            ].map(([k, v]) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-hair py-3.5">
                <dt class="text-[0.95rem] text-graphite">{k}</dt>
                <dd class="num text-[0.78rem] uppercase tracking-[0.12em] text-muted">{v}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-6 text-[0.82rem] leading-relaxed text-faint">
            Durées indicatives en voiture. Digne est aussi le terminus du Train des Pignes,
            qui rejoint Nice par la montagne. L’adresse exacte du chalet est communiquée à
            la confirmation de la réservation.
          </p>
        </div>

        <div data-anim="capsule" class="overflow-hidden border border-hair bg-bone">
          {/* Vue de quartier, volontairement large : une location saisonnière
              ne pointe pas sa porte d'entrée sur une carte publique. */}
          <iframe title="Carte de Digne-les-Bains et de ses environs" class="h-[420px] w-full border-0 lg:h-full lg:min-h-[520px]"
                  loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                  src={mapUrl()}></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Vers la réservation -->
  <section class="section">
    <div class="container-x flex flex-wrap items-center justify-between gap-8 border-t border-hair pt-14">
      <p data-contenu="digne.conclusion" class="lead max-w-md">Le chalet est au milieu de tout cela, au calme de son jardin.</p>
      <div class="flex flex-wrap gap-4">
        <a href="/le-chalet" class="btn btn-ghost">Découvrir le chalet</a>
        <a href={VILLA.airbnb} target="_blank" rel="noopener" class="btn btn-primary">Réserver</a>
      </div>
    </div>
  </section>
</Layout>
