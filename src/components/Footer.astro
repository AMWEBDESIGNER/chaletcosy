---
import Brand from './Brand.astro';
import { AGENCY } from '../lib/legal';
import { VILLA } from '../lib/villa';
const year = new Date().getFullYear();
const A = AGENCY;
const cols = [
  { t: 'Le chalet', links: [['Le chalet', '/le-chalet'], ['Galerie', '/galerie'], ['Digne-les-Bains', '/digne-les-bains'], ['Contact', '/contact']] },
  { t: 'Séjourner', links: [['Réserver', '/contact'], ['Longs séjours', '/contact'], ['Demander une date', '/contact']] },
];
const ext = (h: string) => h.startsWith('http');
---
<footer class="bg-ink text-bone">
  <div class="container-x section !pb-12">
    <!-- haut : signature -->
    <div class="grid gap-14 border-b border-hair-dk pb-14 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <span class="eyebrow !text-bronze-lt">Entre Alpes et Provence</span>
        <p class="mt-6 max-w-xl font-serif text-[clamp(1.6rem,3.4vw,2.6rem)] leading-[1.15] tracking-tight text-bone/95">
          Un chalet, un jardin, la montagne — et rien d’autre à partager.
        </p>
      </div>
      <div class="self-end">
        <span class="text-[0.72rem] uppercase tracking-[0.18em] text-bone/65">Demander les disponibilités</span>
        <form data-form data-subject="Demande de disponibilités — Chalet Cosy"
              class="mt-4 flex items-end gap-5 border-b border-hair-dk pb-1">
          <label class="sr-only" for="nl-email">Votre adresse e-mail</label>
          {/* Pas de `focus:outline-none` : Tailwind ne retire pas l'anneau, il le
              rend transparent — le champ restait donc focalisable sans que rien
              ne le signale. Il reprend l'anneau du système, éclairci sur la nuit. */}
          <input id="nl-email" type="email" name="E-mail" required placeholder="Votre adresse e-mail"
                 class="min-w-0 flex-1 border-0 bg-transparent py-2 text-[0.95rem] text-bone placeholder:text-bone/60" />
          <button class="link-arrow whitespace-nowrap pb-2 !text-bone">
            Envoyer
            <svg width="22" height="8" viewBox="0 0 22 8" fill="none" aria-hidden="true"><path d="M0 4h20M17 1l3 3-3 3" stroke="currentColor" stroke-width="1"/></svg>
          </button>
        </form>
        <p class="mt-3 text-xs text-bone/60">Nous vous répondons personnellement sous 24 heures.</p>
      </div>
    </div>

    <!-- milieu : colonnes -->
    <div class="grid gap-10 py-14 sm:grid-cols-2 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <Brand variant="full" tone="or" class="foot-brand" />
      {cols.map((c) => (
        <nav aria-label={c.t}>
          <h2 class="font-sans text-[0.7rem] uppercase tracking-[0.18em] text-bone/60">{c.t}</h2>
          <ul class="mt-5 space-y-3 text-sm text-bone/80">
            {c.links.map(([l, h]) => (
              <li>
                <a href={h} class="ul-link hover:text-bone"
                   target={ext(h) ? '_blank' : undefined} rel={ext(h) ? 'noopener' : undefined}>{l}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
      <div>
        <h2 class="font-sans text-[0.7rem] uppercase tracking-[0.18em] text-bone/60">Contact</h2>
        <ul class="mt-5 space-y-3 text-sm text-bone/80">
          <li><a href={`mailto:${A.email}`} class="ul-link hover:text-bone">{A.email}</a></li>
          <li class="text-bone/55">{VILLA.city}, {VILLA.department}<br/>{VILLA.region}</li>
          <li class="text-bone/55">Adresse exacte communiquée<br/>à la réservation</li>
        </ul>
      </div>
    </div>

    <!-- mentions de l'éditeur -->
    <div class="border-t border-hair-dk py-8 text-[0.72rem] leading-relaxed text-bone/60">
      <p>
        {A.name} — {A.legalForm} · {A.postalCode} {A.city}, {A.country} · SIRET {A.siret}
      </p>
      <p class="mt-1.5">
        Meublé de tourisme enregistré sous le n° {A.registration.number} auprès de la {A.registration.issuer}.
      </p>
      <p class="mt-1.5">
        Conception et réalisation : <span class="text-bone/55">{A.agencyWeb.name}</span>, {A.agencyWeb.address}.
      </p>
    </div>

    <!-- bas -->
    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-hair-dk pt-8 text-[0.72rem] uppercase tracking-[0.14em] text-bone/60">
      <span>© {year} {A.name}</span>
      <div class="flex flex-wrap gap-x-7 gap-y-2">
        <a href="/mentions-legales" class="ul-link hover:text-bone">Mentions légales</a>
        <a href="/confidentialite" class="ul-link hover:text-bone">Confidentialité</a>
        <button type="button" data-consent-open class="ul-link uppercase tracking-[0.14em] hover:text-bone">Cookies</button>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Le bloc complet, miel sur la forêt — le logo dans sa forme d'origine. */
  :global(.foot-brand) { height: 8rem; }
</style>
